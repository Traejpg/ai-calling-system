# AI Calling System - Environment Configuration
# Copy this file to .env and fill in your values

# =============================================
# Server Configuration
# =============================================
NODE_ENV=development
PORT=3000

# Public URL for webhooks (required for Twilio callbacks)
# For local development, use ngrok: https://ngrok.com/
# For production, use your server URL
WEBHOOK_URL=https://your-ngrok-or-server-url.com

# Logging level: debug, info, warn, error
LOG_LEVEL=info

# =============================================
# Twilio Configuration
# =============================================
# Get these from: https://console.twilio.com/
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your Twilio phone number with voice capabilities
# Must include country code (e.g., +1 for US)
TWILIO_PHONE_NUMBER=+1234567890

# =============================================
# OpenAI Configuration
# =============================================
# Get API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI model for chat completions
# Options: gpt-4, gpt-4-turbo-preview, gpt-3.5-turbo
OPENAI_MODEL=gpt-3.5-turbo

# =============================================
# ElevenLabs Configuration (Optional)
# =============================================
# For high-quality text-to-speech
# Get API key from: https://elevenlabs.io/
ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Voice ID for ElevenLabs TTS
# Default: pMsXgVXv3BLzUgSXRplE (Nova - warm, slightly British)
ELEVENLABS_VOICE_ID=pMsXgVXv3BLzUgSXRplE

# =============================================
# Notion Configuration
# =============================================
# Integration token from: https://www.notion.so/my-integrations
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxx

# Database ID where call data will be stored
# Get this from the database URL or share menu
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================
# SMS Alerts Configuration
# =============================================
# Default phone number to send alerts to
# Must include country code
SMS_ALERT_NUMBER=+1234567890

# =============================================
# Advanced Configuration (Optional)
# =============================================
# Maximum call duration in seconds
MAX_CALL_DURATION=3600

# Recording format: mp3, wav
RECORDING_FORMAT=mp3

# Enable/disable call recording
ENABLE_RECORDING=true

# Webhook authentication secret (for verifying Twilio requests)
# Leave empty to skip signature verification (not recommended for production)
WEBHOOK_SECRET=
